{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .sb-page { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .sb-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .sb-head p { margin: var(--cds-gap-xs) 0 0; color: var(--color-fg-muted); max-width: 70ch; }\n  .sb-take { font-size: var(--cds-font-size-body); color: var(--color-fg) !important; }\n  .sb-page b { font-weight: 600; }\n  .sb-controls { display: grid; gap: var(--cds-gap-sm); }\n  .sb-ctl { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cds-gap-xs); }\n  .sb-ctl > span { min-width: 9.5rem; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .02em; }\n  .sb-ctl button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); cursor: pointer; }\n  .sb-ctl button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); border-color: var(--color-fg); }\n  .sb-ctl button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n  .sb-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--cds-gap-md); }\n  .sb-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); }\n  .sb-tile .sb-lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .sb-tile .sb-num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n  .sb-tile .sb-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .sb-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .sb-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .sb-card .sb-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); max-width: 80ch; }\n  .sb-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); }\n  .sb-legend i { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; margin-right: .35rem; vertical-align: -.05rem; }\n  .sb-chart { position: relative; min-height: 12rem; }\n  .sb-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); max-width: 20rem; z-index: 2; }\n  .sb-tip .sb-tip-h { color: var(--cds-text-secondary); margin-bottom: 2px; }\n  .sb-tablewrap { max-height: 32rem; overflow: auto; }\n  .sb-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .sb-table th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .sb-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .sb-table td.sb-n { text-align: right; }\n  .sb-win { color: var(--color-ok); }\n  .sb-loss { color: var(--color-bad); }\n  .sb-defs { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); display: grid; gap: var(--cds-gap-xs); max-width: 85ch; }\n  .sb-defs p { margin: 0; }\n  @media (max-width: 40rem) { .sb-ctl > span { min-width: 100%; } .sb-hide-narrow { display: none; } }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"sb-page\">\n  <header class=\"sb-head\" id=\"top\">\n    <h1>SUB5 benchmark scorecard</h1>\n    <p class=\"sb-take\">SUB5 wins <b data-draw=\"n-lsml\" data-source=\"comparisons\">\u2014</b> of <b data-draw=\"n-total\" data-source=\"comparisons\">\u2014</b> cells against <b data-draw=\"cmp-name\">\u2014</b>. The plain average of the same channels wins <b data-draw=\"n-avg\" data-source=\"comparisons\">\u2014</b>.</p>\n    <p>SUB5 is six of the 16 telemetry channels (q15_H1, chosen_surprisal, top15_turnover, dominant_freq16, bocpd_p0, digit_spread), fused label-free with L-SML. The channels were chosen with PRMBench and Socratic labels, so only the other benchmarks are out of sample. Development data, Math-Shepherd PRM excluded.</p>\n  </header>\n\n  <div class=\"sb-controls\" id=\"filters\">\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Our method\">\n      <span>Our method</span>\n      <button type=\"button\" data-param=\"arm\" data-value=\"alone\">SUB5 alone (telemetry only)</button>\n      <button type=\"button\" data-param=\"arm\" data-value=\"prm\">SUB5 + PRM</button>\n    </div>\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Compared with\">\n      <span>Compared with</span>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"PRM\">The PRM itself (same rule)</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"TELE_N16\">TELE_N16 (all 16, L-SML)</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"MEAN_N16\">MEAN_N16 (all 16, average)</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"CHAIN_N16\">CHAIN_N16 (PRM + 16)</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"pub:any\">Best published, any</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"pub:Trained PRM\">Best published trained PRM</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"pub:Supervised on labels\">Best published supervised</button>\n      <button type=\"button\" data-param=\"cmp\" data-value=\"pub:Prompted LLM critic\">Best published LLM critic</button>\n    </div>\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Metric\">\n      <span>Metric</span>\n      <button type=\"button\" data-param=\"metric\" data-value=\"main\">Main metric of each benchmark</button>\n      <button type=\"button\" data-param=\"metric\" data-value=\"within_auc\">Within-answer AUC</button>\n      <button type=\"button\" data-param=\"metric\" data-value=\"crop_kept_a05\">CROP kept % at \u03b1 0.05</button>\n      <button type=\"button\" data-param=\"metric\" data-value=\"crop_auroc\">CROP step AUROC</button>\n    </div>\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Benchmarks\">\n      <span>Benchmarks</span>\n      <button type=\"button\" data-param=\"sample\" data-value=\"all\">All</button>\n      <button type=\"button\" data-param=\"sample\" data-value=\"Out of sample\">Out of sample</button>\n      <button type=\"button\" data-param=\"sample\" data-value=\"Used to choose SUB5\">Used to choose SUB5</button>\n    </div>\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Telemetry source\">\n      <span>Telemetry source</span>\n      <button type=\"button\" data-param=\"mode\" data-value=\"all\">Both</button>\n      <button type=\"button\" data-param=\"mode\" data-value=\"backbone\">PRM backbone</button>\n      <button type=\"button\" data-param=\"mode\" data-value=\"standalone\">Standalone base model</button>\n    </div>\n    <div class=\"sb-ctl\" role=\"group\" aria-label=\"Outcome\">\n      <span>Show</span>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"all\">Every cell</button>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"win\">SUB5 wins</button>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"loss\">SUB5 loses</button>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"lsml_only\">Wins only with L-SML</button>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"avg_only\">Average wins, L-SML loses</button>\n      <button type=\"button\" data-param=\"outcome\" data-value=\"beats_all\">Beats average, PRM and best published</button>\n    </div>\n  </div>\n\n  <section class=\"sb-tiles\" id=\"summary\" aria-label=\"Summary\">\n    <div class=\"sb-tile\"><span class=\"sb-lab\">SUB5 (L-SML) wins</span><span class=\"sb-num\" data-draw=\"t-lsml\" data-source=\"comparisons\">\u2014</span><span class=\"sb-sub\">cells where SUB5 is above the comparator</span></div>\n    <div class=\"sb-tile\"><span class=\"sb-lab\">Plain average wins</span><span class=\"sb-num\" data-draw=\"t-avg\" data-source=\"comparisons\">\u2014</span><span class=\"sb-sub\">same six channels, equal weights, no L-SML</span></div>\n    <div class=\"sb-tile\"><span class=\"sb-lab\">Wins that need L-SML</span><span class=\"sb-num\" data-draw=\"t-only\" data-source=\"comparisons\">\u2014</span><span class=\"sb-sub\">SUB5 wins and the average loses</span></div>\n    <div class=\"sb-tile\"><span class=\"sb-lab\">L-SML minus average</span><span class=\"sb-num\" data-draw=\"t-gap\" data-source=\"comparisons\">\u2014</span><span class=\"sb-sub\">mean over the cells shown, metric points</span></div>\n  </section>\n\n  <section class=\"sb-card\" id=\"chart\">\n    <h2>Margin over the comparator, per cell</h2>\n    <p class=\"sb-note\">Each row is one benchmark, telemetry source and PRM. Right of zero means SUB5 is better. With a published comparator, each row ends with the competitor and the paper (and table) its score comes from. The ring is the plain average of the same channels, so the distance between dot and ring is what L-SML adds.</p>\n    <div class=\"sb-legend\"><span><i style=\"background: var(--color-ok)\"></i>SUB5 (L-SML) wins</span><span><i style=\"background: var(--color-bad)\"></i>SUB5 (L-SML) loses</span><span><i style=\"border: 2px solid var(--color-fg-muted)\"></i>plain average of the same channels</span></div>\n    <div class=\"sb-chart\" data-draw=\"chart\" data-source=\"comparisons\"></div>\n  </section>\n\n  <section class=\"sb-card\" id=\"cells\">\n    <h2>Values behind each row</h2>\n    <p class=\"sb-note\">When a published score is selected, the comparator column names the system and the paper column names the paper and table it is printed in. Published scores are taken as printed; their protocols can differ from ours (see the notes below).</p>\n    <div class=\"sb-tablewrap\">\n      <table class=\"sb-table\" data-source=\"comparisons\" data-row-key=\"key\">\n        <thead><tr>\n          <th data-field=\"benchmark_label\">Benchmark</th>\n          <th data-field=\"mode\">Telemetry</th>\n          <th data-field=\"prm_label\">PRM</th>\n          <th data-field=\"sample\" class=\"sb-hide-narrow\">Benchmarks</th>\n          <th data-field=\"metric_label\" class=\"sb-hide-narrow\">Metric</th>\n          <th data-field=\"ours\">SUB5</th>\n          <th data-field=\"avg\">Average</th>\n          <th data-field=\"cmp_label\">Comparator</th>\n          <th data-field=\"cmp_paper\">Paper</th>\n          <th data-field=\"cmp_value\">Comparator value</th>\n          <th data-field=\"d_ours\">SUB5 margin</th>\n          <th data-field=\"d_avg\">Average margin</th>\n        </tr></thead>\n        <tbody data-draw=\"rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"sb-defs\" id=\"notes\">\n    <p>\"Beats average, PRM and best published\" keeps a cell only when SUB5 is above all three at once: the plain average of the same channels, the PRM itself under the same rule, and the best published score of any kind for that benchmark and metric. Cells with no published score never pass this filter.</p>\n    <p>Main metrics: PRMBench PRMScore; Socratic, CRV-Arith, CRV-GSM8K, PRM800K and DeltaBench step macro-F1; Hard2Verify official step balanced F1 (177 answers); ProcessBench average first-error F1. Every SUB5 and TELE/CHAIN/MEAN number uses the label-free GAP count rule; on ProcessBench the NC rule (the PRM's native gate and count, the arm's order). \"The PRM itself\" is that PRM under the same rule (ProcessBench: its native threshold).</p>\n    <p>Papers: PRMBench (arXiv 2501.03124, Table 3), PRISM (2606.09078), PathFinder-PRM (2505.19706), R-PRM (2503.21295), ActPRM (2504.10559), Socratic-PRMBench (2505.23474, Tables 3-4), Hard2Verify (2510.13744, Table 2), the Qwen PRM paper \"The Lessons of Developing PRMs\" (2501.07301, Table 7) for ProcessBench, and CROP (2605.30085, Table 6) for kept % and AUROC (its Direct PRM and Trace+PRM use Qwen2.5-Math-PRM-7B, so they are compared with that PRM only). PRM-specific published rows count only against the same PRM. DeltaBench has no published number on our metric. LLM critics and CROP's supervised rows use labels or many model calls that SUB5 does not.</p>\n    <p>Two cells have no SUB5 score because the six channels form fewer than three L-SML groups: CRV-Arith backbone Qwen-72B (SUB5 + PRM) and CRV-Arith standalone Qwen-7B (SUB5 alone).</p>\n  </section>\n</div>\n\n<script>\n  const MAIN = {prmbench: 'PRMScore_GAP', socratic: 'macro_f1_GAP', hard2verify: 'balanced_f1_GAP', processbench: 'avg_f1_NC',\n                crv_arith: 'macro_f1_GAP', crv_gsm8k: 'macro_f1_GAP', prm800k: 'macro_f1_GAP', deltabench: 'macro_f1_GAP'};\n  const COMPARATORS = ['PRM', 'TELE_N16', 'MEAN_N16', 'CHAIN_N16', 'pub:any', 'pub:Trained PRM', 'pub:Supervised on labels', 'pub:Prompted LLM critic'];\n  dash.calc('comparisons', {\n    title: 'SUB5 against each comparator',\n    description: 'For every cell, SUB5 (L-SML) and the plain average of the same channels minus the comparator, per metric; published scores take the best printed value for the benchmark and metric.',\n    inputs: ['scores', 'published'],\n    fn: (scores, published) => {\n      const v = new Map();\n      for (const r of scores) v.set([r.benchmark, r.mode, r.prm, r.arm, r.metric].join('|'), Number(r.value));\n      const cells = new Map();\n      for (const r of scores) cells.set([r.benchmark, r.mode, r.prm].join('|'), r);\n      const out = [];\n      for (const [ck, c] of cells) {\n        for (const arm of ['alone', 'prm']) {\n          const oursArm = arm === 'alone' ? 'SUB5 alone' : 'SUB5 +PRM';\n          const avgArm = arm === 'alone' ? 'SUB5 mean' : 'SUB5 +PRM mean';\n          for (const mk of ['main', 'within_auc', 'crop_kept_a05', 'crop_auroc']) {\n            const metric = mk === 'main' ? MAIN[c.benchmark] : mk;\n            const ours = v.get([ck, oursArm, metric].join('|'));\n            if (ours === undefined) continue;\n            const avg = v.get([ck, avgArm, metric].join('|'));\n            const prmV = v.get([ck, c.benchmark === 'prmbench' && metric.startsWith('crop') ? 'PRM (1-reward)' : 'PRM', metric].join('|'));\n            const pubC = published.filter((p) => p.benchmark === c.benchmark && p.metric === metric && (p.prm === 'any' || p.prm === c.prm)).map((p) => Number(p.value));\n            const pubV = pubC.length ? Math.max(...pubC) : undefined;\n            const beatsAll = avg !== undefined && prmV !== undefined && pubV !== undefined && ours > avg && ours > prmV && ours > pubV;\n            for (const cmp of COMPARATORS) {\n              let cv, label, paper = 'Our run (same cell)', paperShort = '';\n              if (cmp.startsWith('pub:')) {\n                const acc = cmp.slice(4);\n                const cand = published.filter((p) => p.benchmark === c.benchmark && p.metric === metric && (p.prm === 'any' || p.prm === c.prm) && (acc === 'any' || p.access === acc));\n                if (!cand.length) continue;\n                const best = cand.reduce((a, b) => (Number(b.value) > Number(a.value) ? b : a));\n                cv = Number(best.value); label = best.competitor; paper = best.paper; paperShort = best.paper_short;\n              } else {\n                const a = cmp === 'PRM' && c.benchmark === 'prmbench' && metric.startsWith('crop') ? 'PRM (1-reward)' : cmp;\n                cv = v.get([ck, a, metric].join('|'));\n                if (cv === undefined) continue;\n                label = cmp === 'PRM' ? 'The PRM itself' : cmp;\n              }\n              out.push({key: [ck, arm, mk, cmp].join('|'), benchmark: c.benchmark, benchmark_label: c.benchmark_label, bench_order: Number(c.bench_order),\n                        mode: c.mode, prm: c.prm, prm_label: c.prm_label, sample: c.sample, arm, metric_key: mk, metric_label: c['label_' + mk] || metric,\n                        cmp, cmp_label: label, cmp_paper: paper, cmp_paper_short: paperShort, ours, avg: avg === undefined ? null : avg, cmp_value: cv,\n                        d_ours: ours - cv, d_avg: avg === undefined ? null : avg - cv, beats_all: beatsAll});\n            }\n          }\n        }\n      }\n      return out;\n    },\n  });\n\n  const DEFAULTS = {arm: 'alone', cmp: 'TELE_N16', metric: 'main', sample: 'all', mode: 'all', outcome: 'all'};\n  const P = () => ({...DEFAULTS, ...dash.params()});\n  document.querySelectorAll('.sb-ctl button[data-param]').forEach((b) => b.addEventListener('click', () => dash.setParams({[b.dataset.param]: b.dataset.value})));\n  dash.onData(() => {\n    const p = P();\n    document.querySelectorAll('.sb-ctl button[data-param]').forEach((b) => b.setAttribute('aria-pressed', String(p[b.dataset.param] === b.dataset.value)));\n  });\n\n  window.sbRows = () => {\n    const d = dash.data('comparisons');\n    if (d.status !== 'ok') return null;\n    const p = P();\n    return d.data.filter((r) => r.arm === p.arm && r.cmp === p.cmp && r.metric_key === p.metric\n      && (p.sample === 'all' || r.sample === p.sample) && (p.mode === 'all' || r.mode === p.mode)\n      && (p.outcome === 'all' || (p.outcome === 'win' && r.d_ours > 0) || (p.outcome === 'loss' && r.d_ours <= 0)\n          || (p.outcome === 'lsml_only' && r.d_ours > 0 && r.d_avg !== null && r.d_avg <= 0)\n          || (p.outcome === 'beats_all' && r.beats_all)\n          || (p.outcome === 'avg_only' && r.d_ours <= 0 && r.d_avg !== null && r.d_avg > 0)))\n      .sort((a, b) => a.bench_order - b.bench_order || a.mode.localeCompare(b.mode) || a.prm_label.localeCompare(b.prm_label));\n  };\n  window.sbIsAuc = (m) => m === 'within_auc' || m === 'crop_auroc';\n  window.sbFmt = (x, m) => (x === null || x === undefined || Number.isNaN(x) ? '\u2014' : d3.format(sbIsAuc(m) ? '.3f' : '.2f')(x));\n  window.sbSigned = (x, m) => (x === null || x === undefined ? '\u2014' : (x > 0 ? '+' : '') + d3.format(sbIsAuc(m) ? '.3f' : '.2f')(x));\n</script>\n\n<script>\n  const counts = () => {\n    const rows = sbRows();\n    if (!rows) return null;\n    const withAvg = rows.filter((r) => r.d_avg !== null);\n    return {n: rows.length, lsml: rows.filter((r) => r.d_ours > 0).length, avg: withAvg.filter((r) => r.d_avg > 0).length,\n            only: withAvg.filter((r) => r.d_ours > 0 && r.d_avg <= 0).length,\n            gap: withAvg.length ? d3.mean(withAvg, (r) => r.ours - r.avg) : null, m: dash.params().metric ?? 'main'};\n  };\n  const put = (el, text) => { el.textContent = text; };\n  dash.draw('n-lsml', (el) => { const c = counts(); put(el, c ? String(c.lsml) : '\u2014'); });\n  dash.draw('n-total', (el) => { const c = counts(); put(el, c ? String(c.n) : '\u2014'); });\n  dash.draw('n-avg', (el) => { const c = counts(); put(el, c ? String(c.avg) : '\u2014'); });\n  dash.draw('cmp-name', (el) => {\n    const cmp = dash.params().cmp ?? 'TELE_N16';\n    const names = {PRM: 'the PRM itself', TELE_N16: 'TELE_N16', MEAN_N16: 'MEAN_N16', CHAIN_N16: 'CHAIN_N16', 'pub:any': 'the best published score',\n                   'pub:Trained PRM': 'the best published trained PRM', 'pub:Supervised on labels': 'the best published supervised method',\n                   'pub:Prompted LLM critic': 'the best published LLM critic'};\n    put(el, names[cmp] ?? cmp);\n  });\n  dash.draw('t-lsml', (el) => { const c = counts(); put(el, c ? `${c.lsml} of ${c.n}` : '\u2014'); });\n  dash.draw('t-avg', (el) => { const c = counts(); put(el, c ? `${c.avg} of ${c.n}` : '\u2014'); });\n  dash.draw('t-only', (el) => { const c = counts(); put(el, c ? String(c.only) : '\u2014'); });\n  dash.draw('t-gap', (el) => { const c = counts(); put(el, c && c.gap !== null ? sbSigned(c.gap, c.m) : '\u2014'); });\n\n  dash.draw('rows', (tb) => {\n    const rows = sbRows();\n    tb.replaceChildren();\n    if (!rows) return;\n    for (const r of rows) {\n      const tr = document.createElement('tr'); tr.dataset.key = r.key;\n      const cells = [r.benchmark_label, r.mode, r.prm_label, r.sample, r.metric_label, sbFmt(r.ours, r.metric_key), sbFmt(r.avg, r.metric_key),\n                     r.cmp_label, r.cmp_paper, sbFmt(r.cmp_value, r.metric_key), sbSigned(r.d_ours, r.metric_key), sbSigned(r.d_avg, r.metric_key)];\n      cells.forEach((t, i) => {\n        const td = document.createElement('td'); td.textContent = t;\n        if (i >= 5 && i !== 7 && i !== 8) td.className = 'sb-n';\n        if (i === 3 || i === 4) td.classList.add('sb-hide-narrow');\n        if (i === 10) td.classList.add(r.d_ours > 0 ? 'sb-win' : 'sb-loss');\n        if (i === 11 && r.d_avg !== null) td.classList.add(r.d_avg > 0 ? 'sb-win' : 'sb-loss');\n        tr.append(td);\n      });\n      tb.append(tr);\n    }\n  });\n</script>\n\n<script>\n  dash.draw('chart', (el) => {\n    const rows = sbRows();\n    el.replaceChildren();\n    if (!rows) return;\n    const m = dash.params().metric ?? 'main';\n    const W = Math.max(280, el.clientWidth), rowH = 20, top = 26, bottom = 10;\n    const svg = d3.select(el).append('svg').attr('width', '100%');\n    if (!rows.length) {\n      svg.attr('viewBox', `0 0 ${W} 60`).attr('height', 60).append('text').attr('x', W / 2).attr('y', 34).attr('text-anchor', 'middle')\n        .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)').text('No cells match these filters.');\n      return;\n    }\n    const label = (r) => `${r.benchmark_label} \u00b7 ${r.mode === 'backbone' ? 'backbone' : 'standalone'} \u00b7 ${r.prm_label}`;\n    const probe = svg.append('text').style('font-size', 'var(--cds-font-size-caption)');\n    const narrow = W < 520;\n    let left = 0;\n    for (const r of rows) { probe.text(narrow ? `${r.benchmark_label} \u00b7 ${r.prm_label}` : label(r)); left = Math.max(left, probe.node().getComputedTextLength()); }\n    const pub = rows.some((r) => r.cmp_paper_short) && !narrow;\n    let right = 12;\n    if (pub) { for (const r of rows) { probe.text(`${r.cmp_label} \u00b7 ${r.cmp_paper_short}`); right = Math.max(right, probe.node().getComputedTextLength() + 16); } right = Math.min(right, W * 0.32); }\n    probe.remove(); left = Math.min(left + 12, W * 0.45);\n    const H = top + rows.length * rowH + bottom;\n    svg.attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n    const vals = rows.flatMap((r) => [r.d_ours, r.d_avg]).filter((x) => x !== null);\n    const ext = Math.max(1e-9, d3.max(vals, Math.abs));\n    const x = d3.scaleLinear([-ext * 1.08, ext * 1.08], [left, W - right]).nice();\n    const y = (i) => top + i * rowH + rowH / 2;\n    const ax = svg.append('g').attr('transform', `translate(0,${top - 6})`).call(d3.axisTop(x).ticks(narrow ? 4 : 7).tickFormat(sbIsAuc(m) ? d3.format('+.2f') : d3.format('+.1f')))\n      .attr('font-size', null).attr('font-family', null);\n    ax.selectAll('text').attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n    ax.selectAll('line,path').attr('stroke', 'var(--cds-chart-axis)');\n    svg.append('g').selectAll('line').data(x.ticks(narrow ? 4 : 7)).join('line').attr('x1', (d) => x(d)).attr('x2', (d) => x(d))\n      .attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('line').attr('x1', x(0)).attr('x2', x(0)).attr('y1', top - 6).attr('y2', H - bottom).attr('stroke', 'var(--cds-chart-reference)').attr('stroke-width', 1.5);\n    let prev = null;\n    rows.forEach((r, i) => {\n      if (prev !== null && prev !== r.benchmark) svg.append('line').attr('x1', 0).attr('x2', W).attr('y1', top + i * rowH).attr('y2', top + i * rowH).attr('stroke', 'var(--color-border-line)');\n      prev = r.benchmark;\n    });\n    svg.append('g').selectAll('text').data(rows).join('text').attr('x', left - 10).attr('y', (d, i) => y(i)).attr('dy', '0.35em').attr('text-anchor', 'end')\n      .attr('fill', 'var(--color-fg)').style('font-size', 'var(--cds-font-size-caption)')\n      .text((d) => (narrow ? `${d.benchmark_label} \u00b7 ${d.prm_label}` : label(d)));\n    if (pub) {\n      svg.append('text').attr('x', W - 4).attr('y', top - 12).attr('text-anchor', 'end').attr('fill', 'var(--color-fg-muted)')\n        .style('font-size', 'var(--cds-font-size-caption)').text('Competitor \u00b7 paper');\n      svg.append('g').selectAll('text').data(rows).join('text').attr('x', W - 4).attr('y', (d, i) => y(i)).attr('dy', '0.35em').attr('text-anchor', 'end')\n        .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)')\n        .text((d) => `${d.cmp_label} \u00b7 ${d.cmp_paper_short}`)\n        .each(function () { const n = this; while (n.getComputedTextLength() > right - 10 && n.textContent.length > 4) n.textContent = n.textContent.slice(0, -2) + '\u2026'; });\n    }\n    const g = svg.append('g');\n    g.selectAll('line.sb-link').data(rows.filter((r) => r.d_avg !== null)).join('line').attr('class', 'sb-link')\n      .attr('x1', (d) => x(d.d_avg)).attr('x2', (d) => x(d.d_ours)).attr('y1', (d) => y(rows.indexOf(d))).attr('y2', (d) => y(rows.indexOf(d)))\n      .attr('stroke', 'var(--cds-chart-muted)').attr('stroke-width', 2).attr('stroke-linecap', 'round');\n    g.selectAll('circle.sb-avg').data(rows.filter((r) => r.d_avg !== null)).join('circle').attr('class', 'sb-avg')\n      .attr('cx', (d) => x(d.d_avg)).attr('cy', (d) => y(rows.indexOf(d))).attr('r', 4.5).attr('fill', 'var(--color-panel)')\n      .attr('stroke', 'var(--color-fg-muted)').attr('stroke-width', 1.5);\n    g.selectAll('circle.sb-ours').data(rows).join('circle').attr('class', 'sb-ours')\n      .attr('cx', (d) => x(d.d_ours)).attr('cy', (d, i) => y(i)).attr('r', 5)\n      .attr('fill', (d) => (d.d_ours > 0 ? 'var(--color-ok)' : 'var(--color-bad)'));\n    const tip = d3.select(el).append('div').attr('class', 'sb-tip').style('display', 'none');\n    svg.append('rect').attr('x', 0).attr('y', top).attr('width', W).attr('height', rows.length * rowH).attr('fill', 'transparent')\n      .on('mousemove', (event) => {\n        const [mx, my] = d3.pointer(event, el);\n        const i = Math.floor((d3.pointer(event, svg.node())[1] - top) / rowH);\n        const r = rows[i];\n        if (!r) { tip.style('display', 'none'); return; }\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'sb-tip-h').text(`${label(r)} \u00b7 ${r.metric_label}`);\n        tip.append('div').text(`SUB5 ${sbFmt(r.ours, m)} (${sbSigned(r.d_ours, m)})`);\n        tip.append('div').text(`Average ${sbFmt(r.avg, m)} (${sbSigned(r.d_avg, m)})`);\n        tip.append('div').text(`${r.cmp_label} ${sbFmt(r.cmp_value, m)}`);\n        if (r.cmp_paper_short) tip.append('div').attr('class', 'sb-tip-h').text(r.cmp_paper);\n        const bw = el.clientWidth, tw = tip.node().offsetWidth;\n        tip.style('left', `${Math.min(Math.max(0, mx + 12), bw - tw)}px`).style('top', `${my + 14}px`);\n      })\n      .on('mouseleave', () => tip.style('display', 'none'));\n  });\n</script>\n"}