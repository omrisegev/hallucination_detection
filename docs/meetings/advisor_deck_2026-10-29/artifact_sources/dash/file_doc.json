{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .pv { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .pv-head { display: grid; gap: var(--cds-gap-xs); max-width: 70ch; }\n  .pv-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .pv-lede { margin: 0; color: var(--color-fg); font-size: var(--cds-font-size-body); line-height: 1.5; }\n  .pv .pv-lede b { font-weight: 600; font-variant-numeric: tabular-nums; }\n  .pv-filters { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md) var(--cds-gap-lg); align-items: flex-end; }\n  .pv-filter { display: grid; gap: var(--cds-gap-xs); min-width: 0; }\n  .pv-filter-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .02em; }\n  .pv-seg { display: flex; flex-wrap: wrap; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; }\n  .pv-seg button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); background: var(--color-bg); color: var(--color-fg); border: 0; border-right: 1px solid var(--color-border-line); cursor: pointer; }\n  .pv-seg button:last-child { border-right: 0; }\n  .pv-seg button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); }\n  .pv-seg button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: -2px; }\n  .pv-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pv-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n  .pv-sw { width: .75rem; height: .75rem; border-radius: 2px; display: inline-block; background: var(--cds-chart-muted); }\n  .pv-sw-line { width: 1.25rem; height: 0; border-top: 2px dashed var(--color-bad); border-radius: 0; background: none; }\n  .pv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--cds-gap-md); }\n  .pv-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); position: relative; min-width: 0; }\n  .pv-card h3 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .pv-card p { margin: 0; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .pv-tag { display: inline-block; font-size: var(--cds-font-size-caption); padding: 0 var(--cds-pad-xs); border-radius: var(--cds-radius); border: 1px solid var(--color-border-line); color: var(--color-fg-muted); margin-left: var(--cds-gap-xs); font-weight: 400; }\n  .pv-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n  .pv-tip .k { color: var(--cds-text-secondary); }\n  .pv-empty { color: var(--color-fg-muted); font-size: var(--cds-font-size-body); margin: 0; }\n  .pv-tablecard { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); min-width: 0; }\n  .pv-tablecard h2, .pv-notes h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n  .pv-tablewrap { overflow: auto; max-height: 36rem; }\n  .pv-table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .pv-table th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .pv-table td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .pv-table td.num, .pv-table th.num { text-align: right; }\n  .pv-pill { display: inline-block; padding: 0 var(--cds-pad-xs); border-radius: 999px; border: 1px solid currentColor; }\n  .pv-win { color: var(--color-ok); }\n  .pv-mean { color: var(--color-warn); }\n  .pv-lose { color: var(--color-bad); }\n  .pv-none { color: var(--color-fg-muted); }\n  .pv-notes { display: grid; gap: var(--cds-gap-xs); max-width: 75ch; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.5; }\n  .pv-notes ul { margin: 0; padding-left: 1.2em; display: grid; gap: var(--cds-gap-xs); }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"pv\">\n  <header class=\"pv-head\" id=\"top\">\n    <h1 class=\"pv-title\">PRM telemetry vs competitors</h1>\n    <p class=\"pv-lede\"><span data-draw=\"summary\">\u2014</span></p>\n  </header>\n\n  <div class=\"pv-filters\" id=\"filters\">\n    <div class=\"pv-filter\">\n      <span class=\"pv-filter-label\">Benchmarks</span>\n      <div class=\"pv-seg\" role=\"group\" aria-label=\"Benchmarks\">\n        <button type=\"button\" data-param=\"sample\" data-value=\"all\">All</button>\n        <button type=\"button\" data-param=\"sample\" data-value=\"Selection\">Used to choose SUB5</button>\n        <button type=\"button\" data-param=\"sample\" data-value=\"Out-of-sample\">Out of sample</button>\n      </div>\n    </div>\n    <div class=\"pv-filter\">\n      <span class=\"pv-filter-label\">Result against the competitor</span>\n      <div class=\"pv-seg\" role=\"group\" aria-label=\"Result against the competitor\">\n        <button type=\"button\" data-param=\"outcome\" data-value=\"all\">All</button>\n        <button type=\"button\" data-param=\"outcome\" data-value=\"win\">We beat it</button>\n        <button type=\"button\" data-param=\"outcome\" data-value=\"lose\">We do not</button>\n      </div>\n    </div>\n    <div class=\"pv-filter\">\n      <span class=\"pv-filter-label\">Telemetry from</span>\n      <div class=\"pv-seg\" role=\"group\" aria-label=\"Telemetry from\">\n        <button type=\"button\" data-param=\"telemetry\" data-value=\"all\">Both</button>\n        <button type=\"button\" data-param=\"telemetry\" data-value=\"Backbone\">PRM backbone</button>\n        <button type=\"button\" data-param=\"telemetry\" data-value=\"Standalone\">Standalone base model</button>\n      </div>\n    </div>\n    <div class=\"pv-filter\">\n      <span class=\"pv-filter-label\">Metric</span>\n      <div class=\"pv-seg\" role=\"group\" aria-label=\"Metric\">\n        <button type=\"button\" data-param=\"metric\" data-value=\"headline\">Benchmark's own metric</button>\n        <button type=\"button\" data-param=\"metric\" data-value=\"crop_kept\">CROP: % kept at 5% risk</button>\n        <button type=\"button\" data-param=\"metric\" data-value=\"same_tpr\">PRMBench at PRISM's TPR</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pv-legend\" aria-label=\"Legend\">\n    <span><i class=\"pv-sw\" data-arm=\"PRM_native\"></i>PRM, its own threshold</span>\n    <span><i class=\"pv-sw\" data-arm=\"PRM\"></i>PRM, our label-free rule</span>\n    <span><i class=\"pv-sw\" data-arm=\"MEAN\"></i>Telemetry, plain mean</span>\n    <span><i class=\"pv-sw\" data-arm=\"TELE\"></i>Telemetry, L-SML (TELE_N16)</span>\n    <span><i class=\"pv-sw\" data-arm=\"SUB5\"></i>SUB5, L-SML</span>\n    <span><i class=\"pv-sw\" data-arm=\"CHAIN\"></i>PRM + telemetry (CHAIN)</span>\n    <span><i class=\"pv-sw\" data-arm=\"SUB5_PRM\"></i>SUB5 + PRM</span>\n    <span><i class=\"pv-sw pv-sw-line\"></i>Competitor's published number</span>\n  </div>\n\n  <p class=\"pv-empty\" id=\"pv-empty\" hidden>No results match these filters. CRV, PRM800K and DeltaBench have no published competitor number for their own metric, so they show only under \"All\".</p>\n\n  <section class=\"pv-grid\" id=\"charts\" data-draw=\"grid\" data-source=\"results competitors cells\"></section>\n\n  <section class=\"pv-tablecard\" id=\"table\">\n    <h2>Every result, one row per benchmark, telemetry source and PRM</h2>\n    <p class=\"pv-empty\">\"Best of ours\" is the highest of TELE_N16, SUB5, CHAIN and SUB5 + PRM. \"L-SML makes the win\" means the plain mean of the same telemetry does not beat the competitor, so the weighting is what gets us over the line.</p>\n    <div class=\"pv-tablewrap\">\n      <table class=\"pv-table\" data-source=\"cells\" data-row-key=\"key\">\n        <thead>\n          <tr>\n            <th data-field=\"benchmark\">Benchmark</th>\n            <th data-field=\"sample\">Set</th>\n            <th data-field=\"telemetry\">Telemetry</th>\n            <th data-field=\"prm\">PRM</th>\n            <th class=\"num\" data-field=\"competitor_value\">Competitor</th>\n            <th class=\"num\" data-field=\"best_value\">Best of ours</th>\n            <th data-field=\"best_arm\">Method</th>\n            <th class=\"num\" data-field=\"mean_value\">Plain mean</th>\n            <th class=\"num\" data-field=\"prm_value\">PRM, our rule</th>\n            <th data-field=\"verdict\">Result</th>\n          </tr>\n        </thead>\n        <tbody data-draw=\"rows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"pv-notes\" id=\"notes\">\n    <h2>How to read this</h2>\n    <ul>\n      <li>\"Used to choose SUB5\" are PRMBench and Socratic-PRMBench. SUB5, and most choices behind CHAIN and TELE_N16, were tuned on them, so wins there are in-sample.</li>\n      <li>Competitor numbers are copied from each paper. PRISM, CROP and the Hard2Verify row used Qwen2.5-Math-PRM-7B, so the same line is drawn for all four PRMs as a reference.</li>\n      <li>CROP's numbers use its own fixed threshold grid; ours use a quantile grid, which alone raises the PRM from 4.8% to 17.2% on PRMBench.</li>\n      <li>PRM800K's CROP line is the best row CROP reports there (a supervised token/format model). The paper's text gives no Trace+PRM value for it.</li>\n      <li>\"Label-free rule\" (GAP) chooses how many steps to flag per answer without labels. On CRV and PRM800K, where only 3 to 7% of steps are wrong, the PRM's own threshold beats every method under this rule.</li>\n      <li>Hard2Verify has 177 answers, DeltaBench 447 (the answers that fit in 4,096 tokens). All numbers are development data.</li>\n    </ul>\n  </section>\n</div>\n\n<script>\n  const ARMS = ['PRM_native', 'PRM', 'MEAN', 'TELE', 'SUB5', 'CHAIN', 'SUB5_PRM'];\n  const OURS = ['TELE', 'SUB5', 'CHAIN', 'SUB5_PRM'];\n  window.pvArmLabel = { PRM_native: 'PRM, its own threshold', PRM: 'PRM, our label-free rule', MEAN: 'Telemetry, plain mean', TELE: 'Telemetry, L-SML', SUB5: 'SUB5, L-SML', CHAIN: 'PRM + telemetry (CHAIN)', SUB5_PRM: 'SUB5 + PRM' };\n  window.pvColor = (arm) => {\n    const c = dash.colors;\n    return { PRM_native: 'var(--cds-chart-muted)', PRM: c[7] || c[6], MEAN: c[2], TELE: c[0], SUB5: c[3], CHAIN: c[1], SUB5_PRM: c[4] }[arm];\n  };\n\n  dash.calc('cells', {\n    title: 'One verdict per result',\n    description: 'For each benchmark, telemetry source, PRM and metric: the best of our methods against the competitor, and whether the plain mean also beats it.',\n    inputs: ['results', 'competitors'],\n    fn: (results, competitors) => {\n      const ours = ['TELE', 'SUB5', 'CHAIN', 'SUB5_PRM'];\n      const names = { TELE: 'Telemetry, L-SML', SUB5: 'SUB5, L-SML', CHAIN: 'PRM + telemetry (CHAIN)', SUB5_PRM: 'SUB5 + PRM' };\n      const comp = new Map(competitors.map((c) => [c.benchmark + '|' + c.metric, c]));\n      const groups = new Map();\n      for (const r of results) {\n        const k = [r.benchmark, r.telemetry, r.prm, r.metric].join('|');\n        if (!groups.has(k)) groups.set(k, { key: k, benchmark: r.benchmark, sample: r.sample, telemetry: r.telemetry, prm: r.prm, metric: r.metric, v: {} });\n        groups.get(k).v[r.arm] = Number(r.value);\n      }\n      return [...groups.values()].map((g) => {\n        const c = comp.get(g.benchmark + '|' + g.metric);\n        let best = null;\n        for (const a of ours) if (g.v[a] != null && (best == null || g.v[a] > g.v[best])) best = a;\n        const bv = best == null ? null : g.v[best];\n        const mv = g.v.MEAN ?? null;\n        let verdict, outcome;\n        if (!c) { verdict = 'No published number'; outcome = 'none'; }\n        else if (bv != null && bv > c.value) {\n          outcome = 'win';\n          verdict = mv == null ? 'Beats it (no mean to compare)' : (mv > c.value ? 'Beats it, the mean does too' : 'Beats it, L-SML makes the win');\n        } else { verdict = 'Does not beat it'; outcome = 'lose'; }\n        return { key: g.key, benchmark: g.benchmark, sample: g.sample, telemetry: g.telemetry, prm: g.prm, metric: g.metric,\n          competitor: c ? c.competitor : null, competitor_value: c ? c.value : null, best_arm: best ? names[best] : null,\n          best_value: bv, mean_value: mv, prm_value: g.v.PRM ?? null, verdict, outcome };\n      });\n    },\n  });\n\n  dash.calc('summary', {\n    title: 'Counts for each filter choice',\n    description: 'How many results beat the competitor, and in how many the plain mean does not, for every choice of benchmark set, telemetry source and metric.',\n    inputs: ['cells'],\n    fn: (cells) => {\n      const out = [];\n      for (const sample of ['all', 'Selection', 'Out-of-sample'])\n        for (const telemetry of ['all', 'Backbone', 'Standalone'])\n          for (const metric of ['headline', 'crop_kept', 'same_tpr']) {\n            const s = cells.filter((c) => (sample === 'all' || c.sample === sample) && (telemetry === 'all' || c.telemetry === telemetry) && c.metric === metric && c.outcome !== 'none');\n            out.push({ sample, telemetry, metric, compared: s.length,\n              wins: s.filter((c) => c.outcome === 'win').length,\n              lsml: s.filter((c) => c.verdict === 'Beats it, L-SML makes the win').length,\n              mean_too: s.filter((c) => c.verdict === 'Beats it, the mean does too').length });\n          }\n      return out;\n    },\n  });\n\n  const DEFAULTS = { sample: 'all', outcome: 'all', telemetry: 'all', metric: 'headline' };\n  window.pvParams = () => ({ ...DEFAULTS, ...Object.fromEntries(Object.entries(dash.params()).filter(([, v]) => v != null)) });\n  window.pvKeep = (c, p) => (p.sample === 'all' || c.sample === p.sample) && (p.telemetry === 'all' || c.telemetry === p.telemetry) && c.metric === p.metric && (p.outcome === 'all' || c.outcome === p.outcome);\n\n  document.querySelectorAll('.pv-seg button').forEach((b) => b.addEventListener('click', () => dash.setParams({ [b.dataset.param]: b.dataset.value })));\n\n  dash.onData(() => {\n    const p = window.pvParams();\n    document.querySelectorAll('.pv-seg button').forEach((b) => b.setAttribute('aria-pressed', String(p[b.dataset.param] === b.dataset.value)));\n    document.querySelectorAll('.pv-sw[data-arm]').forEach((s) => { s.style.background = window.pvColor(s.dataset.arm); });\n    const cells = dash.data('cells');\n    const any = cells.status === 'ok' && cells.data.some((c) => window.pvKeep(c, p));\n    document.querySelectorAll('#pv-empty').forEach((e) => { e.hidden = cells.status !== 'ok' || any; });\n  });\n\n  dash.draw('summary', (el) => {\n    const s = dash.data('summary');\n    if (s.status !== 'ok') { el.textContent = '\u2014'; return; }\n    const p = window.pvParams();\n    const row = s.data.find((r) => r.sample === p.sample && r.telemetry === p.telemetry && r.metric === p.metric);\n    if (!row) { el.textContent = '\u2014'; return; }\n    const where = `sample=${encodeURIComponent(p.sample)}&telemetry=${encodeURIComponent(p.telemetry)}&metric=${encodeURIComponent(p.metric)}`;\n    const num = (field) => {\n      const b = document.createElement('b');\n      b.dataset.source = 'summary'; b.dataset.field = field; b.dataset.where = where;\n      b.textContent = String(row[field]);\n      return b;\n    };\n    el.replaceChildren(\n      'Of ', num('compared'), ' results that have a published competitor number, ', num('wins'),\n      ' beat it. In ', num('lsml'), ' of those wins the plain mean of the same telemetry does not, so L-SML makes the difference; in ',\n      num('mean_too'), ' the mean beats it too. Use the filters to split by benchmark set and telemetry source.');\n  });\n\n  dash.draw('grid', (el) => {\n    const res = dash.data('results'), comp = dash.data('competitors'), cells = dash.data('cells');\n    if (res.status !== 'ok' || comp.status !== 'ok' || cells.status !== 'ok') { el.textContent = '\u2014'; return; }\n    const p = window.pvParams();\n    const keep = new Set(cells.data.filter((c) => window.pvKeep(c, p)).map((c) => c.key));\n    const compMap = new Map(comp.data.map((c) => [c.benchmark + '|' + c.metric, c]));\n    const order = ['PRMBench', 'Socratic-PRMBench', 'Hard2Verify', 'ProcessBench', 'CRV Arithmetic', 'CRV GSM8K', 'PRM800K', 'DeltaBench'];\n    const prms = ['Qwen-7B', 'Qwen-72B', 'PURE', 'RLHFlow'];\n    const panels = [];\n    for (const b of order) for (const t of ['Backbone', 'Standalone']) {\n      const rows = res.data.filter((r) => r.benchmark === b && r.telemetry === t && r.metric === p.metric && keep.has([b, t, r.prm, p.metric].join('|')));\n      if (rows.length) panels.push({ b, t, rows, comp: compMap.get(b + '|' + p.metric) });\n    }\n    el.replaceChildren();\n    const fmt = d3.format('.1f');\n    for (const pn of panels) {\n      const card = document.createElement('article');\n      card.className = 'pv-card';\n      card.id = ('chart-' + pn.b + '-' + pn.t).toLowerCase().replace(/[^a-z0-9]+/g, '-');\n      const h = document.createElement('h3');\n      h.textContent = pn.b;\n      const tag = document.createElement('span'); tag.className = 'pv-tag'; tag.textContent = pn.t === 'Backbone' ? 'PRM backbone' : 'Standalone base model';\n      const tag2 = document.createElement('span'); tag2.className = 'pv-tag'; tag2.textContent = pn.rows[0].sample === 'Selection' ? 'used to choose SUB5' : 'out of sample';\n      h.append(tag, tag2);\n      const note = document.createElement('p');\n      note.textContent = pn.rows[0].metric_label + (pn.comp ? ` \u00b7 competitor: ${pn.comp.competitor}, ${fmt(pn.comp.value)}` : ' \u00b7 no published competitor number for this metric');\n      card.append(h, note);\n      const tip = document.createElement('div'); tip.className = 'pv-tip'; tip.hidden = true;\n      el.append(card);\n      const W = Math.max(280, card.clientWidth - 2 * 16), H = 230;\n      const arms = ARMS.filter((a) => pn.rows.some((r) => r.arm === a));\n      const groups = prms.filter((x) => pn.rows.some((r) => r.prm === x));\n      const vals = pn.rows.map((r) => r.value).concat(pn.comp ? [pn.comp.value] : []);\n      const lo0 = d3.min(vals), hi = d3.max(vals);\n      const lo = pn.rows[0].metric === 'crop_kept' || lo0 < 25 ? 0 : Math.max(0, Math.floor((lo0 - 6) / 5) * 5);\n      const svg = d3.select(card).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`).attr('role', 'img').attr('aria-label', pn.b + ' chart');\n      const y = d3.scaleLinear([lo, hi + (hi - lo) * 0.08], [H - 24, 10]).nice();\n      const yAxis = svg.append('g');\n      yAxis.call(d3.axisLeft(y).ticks(5).tickSize(0)).attr('font-size', null).attr('font-family', null);\n      yAxis.select('.domain').remove();\n      yAxis.selectAll('text').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n      let ml = 0; yAxis.selectAll('text').each(function () { ml = Math.max(ml, this.getComputedTextLength()); });\n      ml += 10; yAxis.attr('transform', `translate(${ml},0)`);\n      svg.insert('g', ':first-child').selectAll('line').data(y.ticks(5)).join('line')\n        .attr('x1', ml).attr('x2', W).attr('y1', (d) => y(d)).attr('y2', (d) => y(d)).style('stroke', 'var(--cds-chart-grid)');\n      const x0 = d3.scaleBand(groups, [ml + 4, W - 4]).paddingInner(0.18).paddingOuter(0.05);\n      const x1 = d3.scaleBand(arms, [0, x0.bandwidth()]).padding(0.08);\n      const xa = svg.append('g').attr('transform', `translate(0,${H - 24})`).call(d3.axisBottom(x0).tickSize(0)).attr('font-size', null).attr('font-family', null);\n      xa.select('.domain').style('stroke', 'var(--cds-chart-axis)');\n      xa.selectAll('text').attr('dy', '1.1em').style('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)');\n      svg.append('g').selectAll('rect').data(pn.rows.filter((r) => groups.includes(r.prm))).join('rect')\n        .attr('x', (r) => x0(r.prm) + x1(r.arm)).attr('width', x1.bandwidth())\n        .attr('y', (r) => y(Math.max(r.value, lo))).attr('height', (r) => Math.max(0, y(lo) - y(Math.max(r.value, lo))))\n        .attr('rx', 2).style('fill', (r) => window.pvColor(r.arm))\n        .on('pointerenter pointermove', (ev, r) => {\n          tip.hidden = false;\n          tip.replaceChildren();\n          const a = document.createElement('div'); a.className = 'k'; a.textContent = r.prm;\n          const b = document.createElement('div'); b.textContent = `${window.pvArmLabel[r.arm]}: ${fmt(r.value)}`;\n          tip.append(a, b);\n          if (pn.comp) { const c = document.createElement('div'); c.className = 'k'; c.textContent = `${r.value > pn.comp.value ? 'Above' : 'Below'} the competitor by ${fmt(Math.abs(r.value - pn.comp.value))}`; tip.append(c); }\n          const box = card.getBoundingClientRect();\n          let left = ev.clientX - box.left + 12; const top = ev.clientY - box.top - 10;\n          if (left + 220 > box.width) left = Math.max(4, ev.clientX - box.left - 230);\n          tip.style.left = left + 'px'; tip.style.top = top + 'px';\n        })\n        .on('pointerleave', () => { tip.hidden = true; });\n      if (pn.comp) {\n        const yc = y(pn.comp.value);\n        svg.append('line').attr('x1', ml).attr('x2', W).attr('y1', yc).attr('y2', yc).style('stroke', 'var(--color-bad)').style('stroke-width', 2).style('stroke-dasharray', '6 4');\n        const lab = svg.append('text').attr('x', W - 2).attr('y', yc - 5).attr('text-anchor', 'end').style('fill', 'var(--color-bad)').style('font-size', 'var(--cds-font-size-caption)').text(`competitor ${fmt(pn.comp.value)}`);\n        if (yc - 18 < 0) lab.attr('y', yc + 14);\n      }\n      card.append(tip);\n    }\n  });\n\n  dash.draw('rows', (tb) => {\n    const cells = dash.data('cells');\n    tb.replaceChildren();\n    if (cells.status !== 'ok') return;\n    const p = window.pvParams();\n    const fmt = (v) => (v == null ? '' : d3.format('.1f')(v));\n    const rank = { win: 0, lose: 1, none: 2 };\n    const rows = cells.data.filter((c) => window.pvKeep(c, p))\n      .sort((a, b) => rank[a.outcome] - rank[b.outcome] || a.benchmark.localeCompare(b.benchmark) || a.telemetry.localeCompare(b.telemetry) || a.prm.localeCompare(b.prm));\n    for (const c of rows) {\n      const tr = document.createElement('tr');\n      tr.dataset.key = c.key;\n      const cols = [c.benchmark, c.sample === 'Selection' ? 'Selection' : 'Out-of-sample', c.telemetry, c.prm, fmt(c.competitor_value), fmt(c.best_value), c.best_arm ?? '', fmt(c.mean_value), fmt(c.prm_value)];\n      cols.forEach((v, i) => { const td = document.createElement('td'); if (i >= 4 && i !== 6) td.className = 'num'; td.textContent = v; tr.append(td); });\n      const td = document.createElement('td');\n      const pill = document.createElement('span');\n      pill.className = 'pv-pill ' + (c.outcome === 'none' ? 'pv-none' : c.outcome === 'lose' ? 'pv-lose' : c.verdict.includes('L-SML') ? 'pv-win' : 'pv-mean');\n      pill.textContent = c.verdict;\n      td.append(pill); tr.append(td); tb.append(tr);\n    }\n  });\n</script>\n"}