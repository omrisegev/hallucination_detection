+def consensus_response_gate(
+    corrected_step_risk: np.ndarray,
+    baseline_step_risk: np.ndarray,
+    segment_offsets: np.ndarray,
+    response_risks: np.ndarray,
+    *,
+    quorum: int = 2,
+) -> ConsensusReadoutResult:
+    """Route a frozen token correction using response-head agreement.
+
+    Each response head votes for the correction when the corrected token
+    summary is closer than the baseline token summary to that head's
+    standardized response risk.  The correction opens for the complete
+    response when at least ``quorum`` heads agree.  No target is accepted.
+    """
+
+    corrected = np.asarray(corrected_step_risk, dtype=np.float64)
+    baseline = np.asarray(baseline_step_risk, dtype=np.float64)
+    offsets = np.asarray(segment_offsets, dtype=np.int64)
+    heads = np.asarray(response_risks, dtype=np.float64)
+    if corrected.shape != baseline.shape or corrected.ndim != 1:
+        raise ValueError("corrected and baseline step risks must align")
+    if offsets.ndim != 1 or offsets[0] != 0 or offsets[-1] != len(corrected):
+        raise ValueError("segment offsets do not cover the step scores")
+    n_responses = len(offsets) - 1
+    if heads.ndim != 2 or heads.shape[1] != n_responses or not np.isfinite(heads).all():
+        raise ValueError("response-head matrix is not heads by responses")
+    if not 1 <= int(quorum) <= heads.shape[0]:
+        raise ValueError("response quorum is outside the head roster")
+
+    def standardize(values: np.ndarray) -> np.ndarray:
+        scale = max(float(np.std(values)), EPS)
+        return (values - float(np.mean(values))) / scale
+
+    baseline_z = standardize(baseline)
+    corrected_z = standardize(corrected)
+    baseline_summary = np.asarray([
+        float(np.mean(baseline_z[offsets[i]:offsets[i + 1]]))
+        for i in range(n_responses)
+    ])
+    corrected_summary = np.asarray([
+        float(np.mean(corrected_z[offsets[i]:offsets[i + 1]]))
+        for i in range(n_responses)
+    ])
+    vote_matrix = np.vstack([
+        np.abs(corrected_summary - standardize(head))
+        < np.abs(baseline_summary - standardize(head))
+        for head in heads
+    ])
+    votes = vote_matrix.sum(axis=0).astype(np.int64)
+    gate = votes >= int(quorum)
+    expanded = np.repeat(gate, np.diff(offsets))
+    routed = baseline_z + expanded * (corrected_z - baseline_z)
+    if not np.isfinite(routed).all():
+        raise RuntimeError("consensus response gate produced non-finite scores")
+    return ConsensusReadoutResult(
+        token_step_risk=routed,
+        response_gate=gate,
+        votes=votes,
+        diagnostics={
+            "schema_version": "ciw-cross-scale-response-consensus-v1",
+            "n_response_heads": int(heads.shape[0]),
+            "quorum": int(quorum),
+            "open_fraction": float(np.mean(gate)),
+            "mean_votes": float(np.mean(votes)),
+            "labels_seen_during_gate": False,
+        },
+    )
+
+
 __all__ = [
-    "CrossScaleTokenResult", "MAX_GATE", "N_FOLDS", "RIDGE",
-    "fit_cross_scale_token_head",
+    "ConsensusReadoutResult", "CrossScaleTokenResult", "MAX_GATE", "N_FOLDS",
