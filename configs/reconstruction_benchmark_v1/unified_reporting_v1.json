      "saved_output_probability_telemetry_one_pass": "primary"
    }
  },
  "claim_boundaries": {
    "edis_context": {
      "allowed": [
        "diagnostic context only"
      ],
      "forbidden": [
        "primary leaderboard",
        "cross-task macro"
      ]
    },
    "leash_stopping": {
      "allowed": [
        "actual policy execution after certification"
      ],
      "forbidden": [
        "paper-exact claim",
        "matched-accuracy claim",
        "cross-task macro"
      ]
    },
    "prefix": {
      "allowed": [
        "retrospective causal early scoring of an unfinished fixed trace"
      ],
      "forbidden": [
        "adaptive stopping",
        "token savings",
        "latency savings",
        "cross-budget macro",
        "cross-task macro"
      ]
    },
    "winner_reference": {
      "allowed": [
        "direct paired 95% interval non-separation from the observed point winner"
      ],
      "forbidden": [
        "equivalence",
        "tie",
        "simultaneous coverage",
        "familywise coverage",
        "winner-selection-adjusted inference"
      ]
    }
  },
