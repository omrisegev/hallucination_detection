{
  "schema_version": "reconstruction-rag-evidence-registry-v1",
  "lane_id": "rag_evidence_benchmark_v1",
  "claim_boundary": {
    "status": "retrospective_application_evidence",
    "labels_previously_opened": true,
    "forbidden": [
      "cross-panel macro",
      "pooling answer, sentence, token, example, or claim units",
      "pooling RefChecker context settings",
      "claiming GASP exact paper-sample reproduction",
      "claiming RefChecker claim extraction evaluation",
      "copying historical scores as an execution substitute"
    ]
  },
  "panels": [
    {
      "panel_id": "ragtruth_evidence_contrast_answer",
      "dataset": "RAGTruth",
      "unit": "answer",
      "access": "teacher_forced_full_noctx_loo_where_available",
      "estimand": "response_hallucination_ranking",
      "methods": ["fixed_rag_iu_pcr"],
      "metrics": ["auroc", "auprc"],
      "primary_split": "test",
      "bootstrap_group": "source_id"
    },
    {
      "panel_id": "ragtruth_evidence_contrast_sentence",
      "dataset": "RAGTruth",
      "unit": "sentence",
      "access": "teacher_forced_full_noctx_loo_where_available",
      "estimand": "sentence_hallucination_ranking",
      "methods": ["fixed_rag_iu_pcr"],
      "metrics": ["auroc", "auprc"],
      "primary_split": "test",
      "bootstrap_group": "source_id"
    },
    {
      "panel_id": "ragtruth_evidence_contrast_token",
      "dataset": "RAGTruth",
      "unit": "scorer_token",
      "access": "teacher_forced_full_noctx_loo_where_available",
      "estimand": "token_overlap_hallucination_ranking",
      "methods": ["fixed_rag_iu_pcr"],
      "metrics": ["auroc", "auprc"],
      "primary_split": "test",
      "bootstrap_group": "source_id"
    },
    {
      "panel_id": "gasp_protocol_sentence",
      "dataset": "RAGTruth balanced GASP cohort",
      "unit": "sentence",
      "access": "teacher_forced_full_noctx_loo_exact_full_vocab_jsd",
      "estimand": "sentence_hallucination_ranking_on_local_protocol_sample",
      "methods": ["gasp_threshold", "fixed_rag_iu_pcr_matched"],
      "metrics": ["auroc", "auprc"],
      "primary_split": "local_400_response_sample",
      "bootstrap_group": "source_id",
      "fidelity": "protocol_reproduction_own_ids_and_splitter"
    },
    {
      "panel_id": "lettucedetect_example",
      "dataset": "RAGTruth",
      "unit": "example",
      "access": "supervised_ragtruth_token_classifier",
      "estimand": "any_predicted_span_vs_any_gold_span",
      "methods": ["lettucedetect_large_modernbert"],
      "metrics": ["f1", "precision", "recall"],
      "primary_split": "test",
      "bootstrap_group": "source_id",
      "fidelity": "exact_local_reproduction"
    },
    {
      "panel_id": "refchecker_threeway",
      "dataset": "KnowHalBench fixed claims",
      "unit": "fixed_claim",
      "access": "supervised_nli_checker",
      "estimand": "three_way_claim_checking",
      "methods": ["refchecker_nli"],
      "metrics": ["accuracy", "macro_f1"],
      "primary_split": "official_fixed_claims",
      "bootstrap_group": "example_id",
      "required_subgroups": ["accurate_context", "noisy_context", "zero_context"]
    },
    {
      "panel_id": "refchecker_binary_claim",
      "dataset": "KnowHalBench fixed claims",
      "unit": "fixed_claim",
      "access": "teacher_forced_full_noctx",
      "estimand": "unsupported_claim_ranking_binary_collapse",
      "methods": ["fixed_rag_iu_pcr_transfer"],
      "metrics": ["auroc", "auprc"],
      "primary_split": "official_fixed_claims",
      "bootstrap_group": "example_id",
      "required_subgroups": ["accurate_context", "noisy_context", "zero_context"]
    }
  ],
  "method_contract": {
    "fixed_rag_iu_pcr": {
      "feature_contract": "shared-token-mixed-v2-applications-v1-2026-08-13",
      "fit_population": "RAGTruth development evidence telemetry",
      "fit_labels": "forbidden",
      "transform_fit": "full-condition token traces, deterministic cap 60000",
      "heads": ["noctx", "loo"],
      "loo_availability": "used per response where registered; Summary rows have full/noctx only and use the noctx head",
      "answer_reducer": "mean",
      "sentence_reducer": "mean",
      "token_reducer": "identity"
    },
    "gasp_threshold": {
      "features": ["gasp_gap", "gasp_jsd0", "gasp_drop", "gasp_jsdloo"],
      "standardization": "within exact local sentence population, label-free",
      "score": "negative sum of four standardized grounding-sensitivity features"
    },
    "fixed_rag_iu_pcr_matched": {
      "base_method": "fixed_rag_iu_pcr",
      "fit_population": "the same frozen RAGTruth development fit",
      "adapter": "mean token risk inside the exact local GASP sentence window",
      "refit_on_gasp": false
    },
    "lettucedetect_large_modernbert": {
      "model": "KRLabsOrg/lettucedect-large-modernbert-en-v1",
      "entry_point": "HallucinationDetector.predict_prompt(prompt, answer)",
      "score_source": "freshly rederived cached raw prediction booleans; no historical metric copy"
    },
    "refchecker_nli": {
      "model": "ynie/roberta-large-snli_mnli_fever_anli_R1_R2_R3-nli",
      "claim_extraction": "out_of_scope",
      "score_source": "freshly rederived cached predicted labels; no historical metric copy"
    },
    "fixed_rag_iu_pcr_transfer": {
      "base_method": "fixed_rag_iu_pcr",
      "fit_population": "the same frozen RAGTruth development fit",
      "adapter": "cross-scorer adaptation: Qwen2.5/RAGTruth-fitted noctx head transferred without refit to Qwen3 fixed-claim telemetry, then mean token risk over each claim",
      "refit_on_refchecker": false,
      "metric_boundary": "binary unsupported collapse only"
    }
  },
  "evaluation": {
    "bootstrap": {
      "draws": 20000,
      "seed": 2026082407,
      "interval": [0.025, 0.975],
      "resampling": "complete source groups with replacement",
      "paired_contrasts": true
    },
    "undefined_metric_status": "METRIC_UNDEFINED_SINGLE_CLASS",
    "cross_panel_macro": "FORBIDDEN",
    "refchecker_setting_pooling": "FORBIDDEN",
    "lane_artifacts": "canonical_byte_stable_csv",
    "downstream_reporting_bridge": "typed_parquet_and_explicit_schema_required_before_integrated_dataset_cell_reporting"
  },
  "fit_visibility": {
    "forbidden_fields": [
      "label", "labels", "gold", "gold_spans", "gold_hallucinated",
      "human_label", "label_unsupported", "response_label", "span_labels",
      "span_token_spans", "source_id", "example_id", "bootstrap_group",
      "private_labels", "target"
    ],
    "raw_source_access": "FORBIDDEN",
    "historical_score_access": "FORBIDDEN"
  },
