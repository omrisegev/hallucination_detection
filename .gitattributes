# Cluster scripts run on Linux — CRLF in .sh/.sbatch fails silently there.
cluster/** text eol=lf
# Hash-sealed experiment artifacts are byte-exact: canonical-JSON loaders and
# SHA-256 replay checks fail closed on any EOL conversion (autocrlf on Windows
# turned the frozen A6-S0a artifacts noncanonical). Never transform them.
results/** -text
# Generated CSV artifacts may intentionally preserve source CRLF bytes for
# checksum-equivalent replay. Treat them as data in diffs so whitespace checks
# do not reinterpret their record terminators as editable-source whitespace.
results/**/*.csv -diff
dataset_cache/**/*.pkl filter=lfs diff=lfs merge=lfs -text
dataset_cache/**/*.pkl.part-* filter=lfs diff=lfs merge=lfs -text
*.pdf binary

# A frozen protocol snapshot is a hashed artifact, not editable source. Its
# SHA-256 is recorded inside the runs that were gated on it, so a checkout that
# rewrites its line endings silently changes its identity: on Windows
# (core.autocrlf=true) the LF blob lands as CRLF and hashes to something the
# gate cannot recognise. Marking it binary makes the checkout byte-exact
# everywhere, which is the only form in which the hash means anything.
docs/experiments/*.frozen-*.md -text whitespace=-blank-at-eof

# This executed Phase-3 runner is SHA-sealed with one historical blank line at
# EOF. Preserve the byte identity while keeping `git diff --check` meaningful
# for every other source file.
scripts/reasoning_localization/run_phase3_family_expert_attribution.py whitespace=-blank-at-eof

# Agent-B research records and their source are content-addressed by the frozen
# T0/Joint manifests. Preserve their historical bytes while preventing
# `git diff --check` from treating intentional trailing/EOF whitespace as an
# editable defect.
docs/experiments/OG_SML_AGENT_B_T0_V1.md whitespace=-blank-at-eol,-blank-at-eof
docs/experiments/PRIOR_ORDER_AUDIT_JOINT_LSML_V1.md whitespace=-blank-at-eol,-blank-at-eof
docs/experiments/PRIOR_ORDER_AUDIT_OG_SML_AGENT_B_V1.md whitespace=-blank-at-eol,-blank-at-eof
results/og_sml_agent_b_v1/*.md whitespace=-blank-at-eol,-blank-at-eof
spectral_utils/og_sml_graph.py whitespace=-blank-at-eof
