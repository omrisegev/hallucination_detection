baselines/lapeigvals/
baselines/losnet/

# Phase 12+ notebooks — re-include (would otherwise match Phase1* above)
!Spectral_Analysis_Phase12*.ipynb
!Spectral_Analysis_Phase13*.ipynb
!Spectral_Analysis_Phase14*.ipynb

# Local runner — downloaded Drive pkls (not committed, re-download from Drive)
local_cache/

# AIRCC replication-grid pkls fetched from the cluster (canonical copy lives on $SHARED/results/repgrid, ~1.5 GB — not for git)
cache/repgrid/

# Generated HTML reports (reproducible from archive.jsonl)
results/runs/
results/report_*.html

# Reconstruction benchmark releases are immutable, locally queryable build
# products.  Keep the protocol, registries, and generators in Git; regenerate
# or archive complete releases separately because they contain per-row scores.
results/reconstruction_benchmark_v1/releases/

# Research-run intermediates. Commit reports, summary tables, manifests, and
# advisor figures; regenerate per-run score matrices and verbose diagnostics.
results/**/*.npz
results/**/diagnostics/
results/**/training_history.csv
results/frozen_24cell_benchmark_failed_nan_diagnostic/

# The frozen 24-cell score bundle is the canonical exception: the standing
# report verifies these hashes and needs the files on a clean clone.
!results/frozen_24cell_benchmark/scores/
!results/frozen_24cell_benchmark/scores/*.npz
!results/frozen_24cell_benchmark/diagnostics/
!results/frozen_24cell_benchmark/diagnostics/*.json

# Phase 15+ notebooks — re-include (would otherwise match Phase1* above)
!Spectral_Analysis_Phase15*.ipynb

# scripts/build holds notebook generators, not Python dist output — re-include
# (the `build/` rule above is meant for packaging artifacts)
!scripts/build/
cluster/submit_backfill.sbatch

# Raw dataset cache — a curated subset of cache/repgrid (+ cache/edis_aime24) uploaded via
# Git LFS: per-sample questions, answers, and token-level stats (CLAUDE.md's rich-save schema)
# behind the committed result CSVs. Deliberate exception to the cache/repgrid "not for git"
# policy above — see dataset_cache/README.md for what's included and why.
!dataset_cache/**
!dataset_cache/**/*.pkl

# 2026-08-20: these 23 consolidation-only pkls are checksum-verified against
# their canonical Drive copies (see dataset_cache/DRIVE_BACKUP_2026_08_20.json).
# Keep manifests/inventories in Git and retain any local payloads as ignored copies.
dataset_cache/four_localization/**/*.pkl
dataset_cache/repgrid/pb_llama31_8b/*.pkl

# 2026-08-19 research consolidation: reproducible heavy intermediates archived
# non-destructively at gdrive:hallucination_detection/consolidated_results/
# integration_2026-08-19/pre_merge_untracked/. Keep compact reports, manifests,
# aggregate tables, and tokenizer provenance in Git; ignore only the archived payloads.
results/automatic_group_free_phase_a6_tokenizers_v1/materialized/
results/automatic_group_free_phase_a6_tokenizers_v2/materialized/
results/early_online_existing_data_v1/*__*/
results/early_online_localization_models_v1/*__*/
results/global_local_online_iu_v1/cells/
results/contextual_stg_router_diagnostic_v1/PER_QUESTION.csv
results/global_local_online_architecture_v2/*PER_QUESTION.csv
results/global_local_online_architecture_v2/*.partial.*
results/global_local_online_iu_v1/PER_TRACE_CONVERGENCE.csv
results/local_online_comprehensive_v1/*PER_QUESTION.csv
results/local_online_comprehensive_v1/STAGE_*_WARNINGS.csv
