# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Jupyter checkpoints
.ipynb_checkpoints/

# Large data / model files
*.pkl
*.bin
*.safetensors
*.pt
*.pth
*.h5
*.ckpt

# Drive / inference caches (large, not for git)
inference_cache.pkl
phase*_results.pkl
*_summary.json

# Environment
.env
*.env
venv/
.venv/
.venv-bem/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Keys / credentials
keys.txt
*.pem
# Narrowly scoped: a bare *token* previously matched any source file with "token" in its
# name (e.g. spectral_utils/token_feature_views.py silently failed to `git add` under it,
# with only a suppressible warning) — restrict to actual credential-shaped filenames.
*.token
.token*
*_token.txt
*_token.json
hf_token*
api_token*
# Live sbatch carries a hardcoded HF_TOKEN — only the .template is tracked
cluster/submit_inference.sbatch
cluster/submit_teacher_forced.sbatch
cluster/submit_conditional_rescore.sbatch
cluster/submit_pb_critic.sbatch
cluster/submit_pb_prm.sbatch
cluster/submit_pb_uprm_baseline.sbatch
cluster/submit_lettucedetect.sbatch
cluster/submit_gasp_exact.sbatch
cluster/submit_prmbench_prm.sbatch
cluster/submit_prmbench_tf.sbatch
cluster/submit_refchecker.sbatch
# Belongs to the per-layer logit-lens work on branch whitebox/per-layer-views. That branch
# added cluster/submit_layer_views.sbatch.template, whose own header states "the live file is
# gitignored because it carries a hardcoded HF_TOKEN" — but it never added the entry, so the
# claim was false and a generated live file would have been committable with a real token.
# Added here so the protection exists on master regardless of when that branch merges.
cluster/submit_layer_views.sbatch

# Generated plots (large, reproducible)
*.png
*.pdf
*.svg

# ...but the research papers themselves DO travel with the repo (~214 MB, 66 PDFs).
# A future session may run on a machine that has the repo and nothing else — no Drive,
# no inference cells, no local PDF library. The papers are the one input that cannot be
# re-derived from anything else here, so they are tracked deliberately.
!papers/**/*.pdf
!papers/*.pdf
!Tenzer2022_Crowdsourcing_Regression_Spectral.pdf
!Unsupervised Ensemble Learning Through Deep Energy-based Models.pdf

# Older / result notebooks — kept local only (may contain API tokens in outputs)
*_res.ipynb
View_Optimizer.ipynb
CoT_EPR_Ensemble*.ipynb
EDIS_Replication*.ipynb
EPR_Validation*.ipynb
Multimodel_EPR_Ensemble*.ipynb
Multiview_EPR_*.ipynb
Multiview_Hallucination_Detection*.ipynb
Temperature_EPR_Ensemble*.ipynb
Unified_EPR_Ensemble*.ipynb
Spectral_Analysis_Phase1*.ipynb
Spectral_Analysis_Phase2*.ipynb
Spectral_Analysis_Phase3*.ipynb
# Phase10+ accidentally matched by Phase1* above — re-include explicitly
!Spectral_Analysis_Phase10*.ipynb
!Spectral_Analysis_Phase11*.ipynb

# Claude Code local settings
.claude/

# Raw conversation logs (private)
Con_with_*.txt
*.txt

