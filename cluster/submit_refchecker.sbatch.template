#!/bin/bash
# TEMPLATE for cluster/submit_refchecker.sbatch — the live file is gitignored because it carries
# a hardcoded HF_TOKEN, exactly like submit_pb_critic.sbatch.
#
# To regenerate the live file ON THE CLUSTER:
#
#   cd /shared/cycle2_tau_averbuch_prj/omrisegev1/code
#   tok=$(grep -m1 '^export HF_TOKEN=' cluster/submit_inference.sbatch | cut -d= -f2-)
#   sed "s|^export HF_TOKEN=.*|export HF_TOKEN=$tok|" \
#       cluster/submit_refchecker.sbatch.template > cluster/submit_refchecker.sbatch
#
# NEVER commit the live file.
#
# WHAT THIS RUNS
# --------------
# `cluster/run_refchecker_claims.py`: Benchmark 2b (unsupported-CLAIM localization). Runs the
# published open checker (RefChecker's own NLIChecker) and our teacher-forced evidence-contrast
# telemetry in ONE pass over the SAME claim rows, so the two arms are aligned by construction
# rather than by a later assertion. Protocol lock: cluster/manifests/refchecker_v1.json.
#
# REQUIRES the corpus built by cluster/prepare_refchecker_data.py. Submit that first and chain:
#
#   P=$(sbatch --parsable -p power-gpu --qos=owner_880 cluster/cpu_job.sbatch \
#         cluster/prepare_refchecker_data.py --out $SHARED/code/data/refchecker_protocol)
#   sbatch -p power-gpu --qos=owner_880 --dependency=afterok:$P cluster/submit_refchecker.sbatch \
#       --out $SHARED/results/refchecker_knowhalbench_open_full
#
# The driver exits 2 (not 85) when the corpus is missing or empty, so a "blocked" panel is
# distinguishable in sacct from a preemption that merely needs resuming.
#
#SBATCH --job-name=spectral_refchk
#SBATCH --gpus=1
#SBATCH --time=08:00:00
#SBATCH --requeue
#SBATCH --signal=B:TERM@900
#SBATCH --output=/shared/cycle2_tau_averbuch_prj/omrisegev1/logs/%x_%j.out
#SBATCH --container-image=nvcr.io/nvidia/pytorch:25.01-py3
#SBATCH --container-mounts=/shared/cycle2_tau_averbuch_prj/omrisegev1:/shared/cycle2_tau_averbuch_prj/omrisegev1
#SBATCH --container-workdir=/shared/cycle2_tau_averbuch_prj/omrisegev1/code
# No --container-name on purpose — same-node enroot-rootfs race between concurrent jobs.

set -uo pipefail

SHARED=/shared/cycle2_tau_averbuch_prj/omrisegev1
export HF_HOME=$SHARED/hf_cache
export HF_DATASETS_CACHE=$SHARED/hf_cache/datasets
export PIP_CACHE_DIR=$SHARED/pip_cache
export PYTHONUSERBASE=/tmp/pyuserbase_${SLURM_JOB_ID}
mkdir -p "$PYTHONUSERBASE"
export HF_TOKEN=REPLACE_ME
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "[sbatch] job $SLURM_JOB_ID on $(hostname), args: $*"

pip install -q --user -r cluster/requirements.txt

exec python cluster/run_refchecker_claims.py "$@"
