#!/bin/bash
# TEMPLATE for cluster/submit_pb_critic.sbatch — the live file is gitignored because it carries
# a hardcoded HF_TOKEN, exactly like submit_inference.sbatch / submit_teacher_forced.sbatch.
#
# To regenerate the live file ON THE CLUSTER, lifting the token from a file that already has one:
#
#   cd /shared/cycle2_tau_averbuch_prj/omrisegev1/code
#   tok=$(grep -m1 '^export HF_TOKEN=' cluster/submit_inference.sbatch | cut -d= -f2-)
#   sed "s|^export HF_TOKEN=.*|export HF_TOKEN=$tok|" \
#       cluster/submit_pb_critic.sbatch.template > cluster/submit_pb_critic.sbatch
#
# NEVER commit the live file.
#
# WHAT THIS RUNS
# --------------
# `cluster/run_processbench_critic.py`: reproduces ProcessBench's OWN critic-model baseline —
# prompt a general LLM to critique a step-by-step solution and name the earliest wrong paragraph.
# Unlike run_teacher_forced.py this IS generation (new critique text per row), so it costs real
# GPU time per row, not a cheap forward pass. See cluster/manifests/pb_critic_qwen72b_v1.json for
# the full protocol lock. Pilot first (N=30/subset), full N=3400 only after a separate approval.
#
# Submit (partition/QoS on the command line; trailing args go to run_processbench_critic.py):
#
#   sbatch -p power-gpu --qos=owner_880 cluster/submit_pb_critic.sbatch \
#       --model Qwen/Qwen2.5-72B-Instruct --n-samples 30 \
#       --out /shared/cycle2_tau_averbuch_prj/omrisegev1/results/pb_critic_qwen72b_pilot
#
#SBATCH --job-name=spectral_pbc
#SBATCH --gpus=1
#SBATCH --time=08:00:00
#SBATCH --requeue
#SBATCH --signal=B:TERM@900
#SBATCH --output=/shared/cycle2_tau_averbuch_prj/omrisegev1/logs/%x_%j.out
#SBATCH --container-image=nvcr.io/nvidia/pytorch:25.01-py3
#SBATCH --container-mounts=/shared/cycle2_tau_averbuch_prj/omrisegev1:/shared/cycle2_tau_averbuch_prj/omrisegev1
#SBATCH --container-workdir=/shared/cycle2_tau_averbuch_prj/omrisegev1/code
# No --container-name on purpose — see submit_teacher_forced.sbatch.template's note on same-node
# enroot-rootfs races between concurrently landing jobs.

set -uo pipefail

SHARED=/shared/cycle2_tau_averbuch_prj/omrisegev1
export HF_HOME=$SHARED/hf_cache
export HF_DATASETS_CACHE=$SHARED/hf_cache/datasets
export PIP_CACHE_DIR=$SHARED/pip_cache
export PYTHONUSERBASE=/tmp/pyuserbase_${SLURM_JOB_ID}
mkdir -p "$PYTHONUSERBASE"
export HF_TOKEN=REPLACE_ME
# Fragmentation fix for long single-sequence generation on a 72B model — see
# cluster/submit_inference.sbatch's own comment (job 169914) for the OOM this prevents.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "[sbatch] job $SLURM_JOB_ID on $(hostname), args: $*"

pip install -q --user -r cluster/requirements.txt

exec python cluster/run_processbench_critic.py "$@"
