#!/bin/bash
# TEMPLATE for cluster/submit_gasp_exact.sbatch — the live file is gitignored because it carries
# a hardcoded HF_TOKEN, exactly like submit_conditional_rescore.sbatch.
#
# To regenerate the live file ON THE CLUSTER:
#
#   cd /shared/cycle2_tau_averbuch_prj/omrisegev1/code
#   tok=$(grep -m1 '^export HF_TOKEN=' cluster/submit_inference.sbatch | cut -d= -f2-)
#   sed "s|^export HF_TOKEN=.*|export HF_TOKEN=$tok|" \
#       cluster/submit_gasp_exact.sbatch.template > cluster/submit_gasp_exact.sbatch
#
# NEVER commit the live file.
#
# WHAT THIS RUNS
# --------------
# `cluster/run_gasp_exact.py`: the published competitor for Benchmark 2a (unsupported-sentence
# localization) under GASP's OWN protocol — K=5 sentence-grouped chunks, 700/200 token caps,
# 400 class-balanced Summary+Data2txt responses — with the Jensen-Shannon divergence of
# Eqs. (9)/(11) computed over the FULL vocabulary online during the forward pass. The existing
# arm on the preregistered cache can only approximate that from top-50 log-probs.
#
# ~400 responses x 7 conditions = 2,800 forward passes of a 1.5B model on a 200-token answer:
# well under an hour, hence --time=04:00:00. Protocol lock: cluster/manifests/gasp_exact_v1.json.
#
# Submit:
#
#   sbatch -p power-gpu --qos=owner_880 cluster/submit_gasp_exact.sbatch \
#       --model Qwen/Qwen2.5-1.5B-Instruct \
#       --out /shared/cycle2_tau_averbuch_prj/omrisegev1/results/gasp_ragtruth_exact_qwen15b_full
#
#SBATCH --job-name=spectral_gasp
#SBATCH --gpus=1
#SBATCH --time=04:00:00
#SBATCH --requeue
#SBATCH --signal=B:TERM@900
#SBATCH --output=/shared/cycle2_tau_averbuch_prj/omrisegev1/logs/%x_%j.out
#SBATCH --container-image=nvcr.io/nvidia/pytorch:25.01-py3
#SBATCH --container-mounts=/shared/cycle2_tau_averbuch_prj/omrisegev1:/shared/cycle2_tau_averbuch_prj/omrisegev1
#SBATCH --container-workdir=/shared/cycle2_tau_averbuch_prj/omrisegev1/code
# No --container-name on purpose — same-node enroot-rootfs race between concurrent jobs.

set -uo pipefail

SHARED=/shared/cycle2_tau_averbuch_prj/omrisegev1
export HF_HOME=$SHARED/hf_cache
export HF_DATASETS_CACHE=$SHARED/hf_cache/datasets
export PIP_CACHE_DIR=$SHARED/pip_cache
export PYTHONUSERBASE=/tmp/pyuserbase_${SLURM_JOB_ID}
mkdir -p "$PYTHONUSERBASE"
export HF_TOKEN=REPLACE_ME
# The exact-JSD path materializes (n_conditions x answer_tokens x vocab) log-probs at once;
# expandable segments keep that allocation from fragmenting across responses.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "[sbatch] job $SLURM_JOB_ID on $(hostname), args: $*"

pip install -q --user -r cluster/requirements.txt

exec python cluster/run_gasp_exact.py "$@"
