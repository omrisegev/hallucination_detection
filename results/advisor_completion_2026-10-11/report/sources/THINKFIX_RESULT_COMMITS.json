[{"sha":"8810e49ee75c6a0fb044dfef10ea7e0ff1634225","node_id":"C_kwDOP-YQ3toAKDg4MTBlNDllZTc1YzZhMGZiMDQ0ZGZlZjEwZWE3ZTBmZjE2MzQyMjU","commit":{"author":{"name":"omrisegev","email":"omrisegev.os@gmail.com","date":"2026-10-11T05:39:28Z"},"committer":{"name":"omrisegev","email":"omrisegev.os@gmail.com","date":"2026-10-11T05:39:28Z"},"message":"Add supervised LR re-score to thinkfix_rescore_v1\n\nRe-runs monday_lr_reference_v1 and monday_lr_weights_v1 on the old,\nthinkfix and thinkfix_mask1 banks (patched copies + DIFF.txt beside each).\nThe first run failed in aggregate on relative_to(MAIN) for variant paths\noutside the mirror; run_lr_rescore.py now patches that call too.\n\nOld replay reproduces the frozen N16 nested-CV LR within-AUC 0.822366\n(gate enforced). mask1: N16 LR 0.8224 -> 0.8015; its lead over the best\nlabel-free scorer narrows 0.026 -> 0.023. Comparison tables and the\nhandoff are updated.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"f686b61a704eb16939a5074b9ddbd147970874d2","url":"https://api.github.com/repos/omrisegev/hallucination_detection/git/trees/f686b61a704eb16939a5074b9ddbd147970874d2"},"url":"https://api.github.com/repos/omrisegev/hallucination_detection/git/commits/8810e49ee75c6a0fb044dfef10ea7e0ff1634225","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/omrisegev/hallucination_detection/commits/8810e49ee75c6a0fb044dfef10ea7e0ff1634225","html_url":"https://github.com/omrisegev/hallucination_detection/commit/8810e49ee75c6a0fb044dfef10ea7e0ff1634225","comments_url":"https://api.github.com/repos/omrisegev/hallucination_detection/commits/8810e49ee75c6a0fb044dfef10ea7e0ff1634225/comments","author":{"login":"omrisegev","id":68779075,"node_id":"MDQ6VXNlcjY4Nzc5MDc1","avatar_url":"https://avatars.githubusercontent.com/u/68779075?v=4","gravatar_id":"","url":"https://api.github.com/users/omrisegev","